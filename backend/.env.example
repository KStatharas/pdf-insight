# Copy to .env (never commit .env). Only LLM_API_KEY and ALLOWED_ORIGINS are required.

# Google AI Studio key (https://aistudio.google.com/apikey). GEMINI_API_KEY is accepted too.
LLM_API_KEY=

# Comma-separated origins allowed by CORS, e.g. https://<user>.github.io (no path).
ALLOWED_ORIGINS=http://localhost:5173

# gemini = native Gemini API (default; works with the "AQ." keys AI Studio issues today).
# openai = any OpenAI-compatible Chat Completions API (then also set LLM_BASE_URL).
LLM_PROVIDER=gemini
# Leave empty for the provider's default endpoint.
LLM_BASE_URL=
LLM_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or rate limited (comma-separated).
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Gemini thinking level / OpenAI reasoning effort: low | medium | high, or empty for default.
LLM_REASONING_EFFORT=low
# json_schema | json_object | none
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=40

# Limits
MAX_FILE_MB=10
MAX_PAGES=500
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600
MAX_CONCURRENT_ANALYSES=3

# Long documents are split into chunks of CHUNK_CHARS characters, at most MAX_CHUNKS of them.
CHUNK_CHARS=60000
MAX_CHUNKS=4

# OCR of scanned pages (pages with images but fewer than OCR_MIN_CHARS characters of text).
OCR_ENABLED=true
OCR_MAX_PAGES=4
OCR_MIN_CHARS=20
